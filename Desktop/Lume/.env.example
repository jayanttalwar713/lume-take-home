# LLM provider — default is Groq (free at console.groq.com)
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Judge model (used by --judge flag) — smaller/faster is fine
JUDGE_MODEL=llama-3.1-8b-instant

# Sentence-transformers embedding model (local, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Alternative providers (replace the three vars above) ---
# Google AI Studio (free): https://aistudio.google.com/apikey
# LLM_API_KEY=your_google_key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# OpenAI:
# LLM_API_KEY=your_openai_key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
